# Copia a config.env y completa. config.env está en .gitignore.

# Credenciales RHNube (empleador/admin)
EMAIL=
PASSWORD=

# API key de 2captcha para resolver el reCAPTCHA v2 del login.
# Solo se consume cuando la sesión expira (~8h de inactividad). Con el cron
# corriendo dentro de ese margen, casi nunca se usa.
TWOCAPTCHA_KEY=

# IDs de dispositivo biométrico, separados por coma. Vacío = todos.
DISPOSITIVOS=5488

# Días hacia atrás que re-sincroniza cada corrida (recoge marcas retroactivas).
LOOKBACK=2

# Archivo SQLite, archivo de cookies y puerto de la API.
# En Docker estas dos rutas se fijan al volumen (/app/data) desde docker-compose.yml.
DB=marcaciones.db
COOKIE_FILE=cookies.json
PORT=3000

# Cron del sync automático. Default: cada 20 min de 6am a 10am (zona America/Lima).
#   */20 6-10 * * *   -> dispara en :00 :20 :40 de las 6,7,8,9,10 (última 10:40)
#   */20 6-9 * * *    -> si prefieres cortar a las 9:40 y no pasar de las 10
CRON=*/20 6-10 * * *

# Ping para mantener viva la sesión y evitar el login diario (~1 min de captcha).
# Cada 2 horas (< 8h de expiración). Refresca gratis; solo re-loguea si murió.
KEEPALIVE_CRON=0 */2 * * *

# Umbral (USD) para avisar SALDO BAJO de 2captcha tras un login.
BALANCE_MIN=0.5
